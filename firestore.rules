rules_version = '2';

// ===============================================================
// Assumed Data Model — Distribuidora Chibli POS & Route
// ===============================================================
//
// Collection: products/{productId}
//   - name: string (nombre del producto)
//   - price: number >= 0 (precio unitario de venta)
//   - precioCosto: number >= 0 (opcional, costo unitario)
//   - stock: number >= 0 (inventario disponible en piezas)
//   - piezas: number (piezas por caja)
//   - category, unit, emoji, image, barcode: string (metadatos del catálogo)
//
// Collection: customers/{customerId}
//   - storeName: string (nombre de la tienda)
//   - ownerName: string (nombre del dueño/encargado)
//   - phone, zone, address: string (contacto y ubicación en ruta)
//   - createdAt: timestamp (opcional)
//
// Collection: vendedores/{vendedorId}
//   - folio: string (código de vendedor, ej. VEN-001)
//   - nombre: string (nombre completo del vendedor)
//   - email, telefono, zona, password, estado: string (datos de acceso y ruta)
//
// Collection: orders/{orderId}
//   - customerId: string (ID de la tienda cliente)
//   - customerName, ownerName, phone, address: string (datos de entrega)
//   - lines: list (productos vendidos, cantidad > 0)
//   - total: number >= 0 (importe total cobrado)
//   - totalDescuento: number >= 0 (descuento aplicado)
//   - status: string ('Entregado')
//   - vendedorId, vendedorFolio, vendedorNombre: string | null
//   - createdAt: timestamp
//
// Collection: gastos/{gastoId}
//   - categoria: string (Gasolina, Compra de mercancía, Salarios, etc.)
//   - monto: number > 0 (importe del egreso)
//   - descripcion, responsable: string (opcional)
//   - fecha: string (YYYY-MM-DD)
//   - createdAt: timestamp (opcional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'nel0407gael@gmail.com' ||
        request.auth.token.email == 'admin@chibli.com'
      );
    }

    // 1. PRODUCTOS (Catálogo e Inventario)
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock <= resource.data.stock
      );
    }

    // 2. CLIENTES / TIENDAS (Ruta y Comercios)
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. VENDEDORES (Acceso en Ruta y Gestión Admin)
    match /vendedores/{vendedorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 4. PEDIDOS / VENTAS (Carrito, Historial, Dashboard, Caja, Tickets, Pedidos)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.customerId is string &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0;
      allow update, delete: if isAdmin();
    }

    // 5. GASTOS (Módulo de Contabilidad / Caja)
    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    // 6. DENEGACIÓN POR DEFECTO
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
